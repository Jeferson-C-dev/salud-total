<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/header_curve">

            <ImageView
                android:id="@+id/btnRegresar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="36dp"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="46dp"
                android:text="Mi perfil"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Avatar flotante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="-84dp">

            <LinearLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/circle_ring"
                android:gravity="center"
                android:elevation="8dp">

                <LinearLayout
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:background="@drawable/circle_blue"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvIniciales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JC"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNombreCompleto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Apellido"
                android:textColor="#0A1B2E"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="24dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvEmailPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="correo@email.com"
                android:textColor="#6B8299"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente"
                android:textColor="#0F6E56"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/badge_green"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Tarjeta de datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_login"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:padding="22dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos personales"
                android:textColor="#0A1B2E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Nombre y apellido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 Nombre"
                        android:textColor="#6B8299"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_box"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0A1B2E"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apellido"
                        android:textColor="#6B8299"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etApellido"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_box"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0A1B2E"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DNI y teléfono -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪪 DNI"
                        android:textColor="#6B8299"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etDni"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_box"
                        android:inputType="number"
                        android:maxLength="8"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0A1B2E"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Teléfono"
                        android:textColor="#6B8299"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/input_box"
                        android:inputType="phone"
                        android:maxLength="9"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp"
                        android:textColor="#0A1B2E"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/button_gradient"
                android:text="Guardar cambios"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/tvCambiarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 Cambiar contraseña"
                android:textColor="#2E86DE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 Tus datos están protegidos · Ley N.° 29733"
            android:textColor="#A9BCCF"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="22dp" />

    </LinearLayout>
</ScrollView>