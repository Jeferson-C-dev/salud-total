<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF3F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#0A1B2E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Firma de aceptación"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_white"
        android:layout_margin="20dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvFechaAceptacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de aceptación"
            android:textColor="#0A1B2E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:id="@+id/imgFirma"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/input_box"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvSinFirma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay una firma guardada"
            android:textColor="#6B8299"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="12dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>