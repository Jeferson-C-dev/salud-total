<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/circle_blue"
            android:gravity="center">

            <TextView
                android:id="@+id/tvIniciales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNombreMedico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Nombre"
                android:textColor="#0A1B2E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEspecialidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Especialidad"
                android:textColor="#6B8299"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvColegiatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CMP00000"
                android:textColor="#A9BCCF"
                android:textSize="11sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchActivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#2E86DE"
            android:trackTint="#A9BCCF" />

    </LinearLayout>

</LinearLayout>