<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF3F8">

    <!-- Cabecera -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/header_curve">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="30dp"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="38dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Mis citas"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus consultas programadas"
                android:textColor="#48CAE4"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSinCitas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📭 No tienes citas programadas"
        android:textColor="#6B8299"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-20dp"
        android:padding="16dp"
        android:clipToPadding="false" />

</LinearLayout>