<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF3F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/header_curve"
                android:orientation="horizontal"
                android:gravity="top|center_vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="44dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola 👋"
                        android:textColor="#A9BCCF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvNombrePaciente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre Apellido"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Qué necesitas hoy?"
                        android:textColor="#48CAE4"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_ring"
                    android:gravity="center"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvIniciales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JC"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Indicadores flotantes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="-50dp"
                android:layout_marginHorizontal="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="8dp">

                    <TextView
                        android:id="@+id/tvActivas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#2E86DE"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Citas activas"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:elevation="8dp">

                    <TextView
                        android:id="@+id/tvHojas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#0F6E56"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hojas evitadas"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accesos rápidos"
                android:textColor="#0A1B2E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="10dp" />

            <!-- Fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="14dp">

                <!-- Reservar -->
                <LinearLayout
                    android:id="@+id/cardReservar"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="4dp">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_blue"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reservar cita"
                        android:textColor="#0A1B2E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agenda tu consulta"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Mis citas -->
                <LinearLayout
                    android:id="@+id/cardMisCitas"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="4dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <LinearLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/circle_green"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_list"
                                app:tint="#FFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeCitas"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/badge_rojo"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis citas"
                        android:textColor="#0A1B2E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revisa tu agenda"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp">

                <!-- Perfil -->
                <LinearLayout
                    android:id="@+id/cardPerfil"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="4dp">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_blue"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_person"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi perfil"
                        android:textColor="#0A1B2E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos y contraseña"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Ubicación -->
                <LinearLayout
                    android:id="@+id/cardUbicacion"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/card_tile"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="4dp">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circle_orange"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubicación"
                        android:textColor="#0A1B2E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver en Google Maps"
                        android:textColor="#6B8299"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Banner ODS 12 -->
            <LinearLayout
                android:id="@+id/cardOds12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_ods"
                android:padding="18dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cero papel · ODS 12"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOds12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Con tus citas digitales evitaste 0 hojas"
                        android:textColor="#E1F5EE"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnCerrarSesion"
        style="@style/OutlineButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="12dp"
        android:text="Cerrar sesión" />

</LinearLayout>