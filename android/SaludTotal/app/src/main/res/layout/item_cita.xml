<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_cita"
    android:padding="16dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="14dp"
    android:elevation="4dp">

    <!-- Encabezado: avatar, nombre y estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_blue"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvMedico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#0A1B2E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEspecialidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle"
                android:textColor="#6B8299"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textColor="#854F0B"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fecha y hora destacadas -->
    <TextView
        android:id="@+id/tvFechaHora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha · Hora"
        android:textColor="#0A1B2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#F4F8FC"
        android:padding="12dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notas"
        android:textColor="#0F6E56"
        android:textSize="12sp"
        android:background="@drawable/badge_green"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_green"
            android:text="✅ Confirmar"
            android:textAllCaps="false"
            android:textColor="#0F6E56"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCompletar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_blue"
            android:text="✔️ Completar"
            android:textAllCaps="false"
            android:textColor="#185FA5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNoAsistio"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_bg"
            android:text="🚫 No asistió"
            android:textAllCaps="false"
            android:textColor="#854F0B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReprogramar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_blue"
            android:text="🔄 Reprogramar"
            android:textAllCaps="false"
            android:textColor="#185FA5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_red"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_red"
            android:text="🗑️ Eliminar"
            android:textAllCaps="false"
            android:textColor="#A32D2D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>