<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/splash_bg">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/circle_ring"
        android:gravity="center"
        android:layout_marginBottom="26dp">

        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/circle_blue"
            android:gravity="center"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salud Total"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu salud en tus manos"
        android:textColor="#48CAE4"
        android:textSize="16sp"
        android:letterSpacing="0.05"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="52dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="5dp"
        android:progressTint="#48CAE4"
        android:progressBackgroundTint="#33FFFFFF"
        android:progress="0"
        android:max="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargando..."
        android:textColor="#A9BCCF"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌱 Cero papel · ODS 12"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="40dp" />

</LinearLayout>