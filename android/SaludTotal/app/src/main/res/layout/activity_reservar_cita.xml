<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/header_curve">

            <ImageView
                android:id="@+id/btnRegresar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="30dp"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="44dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Reservar cita"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completa los datos de tu consulta"
                    android:textColor="#48CAE4"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tarjeta flotante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_login"
            android:layout_marginTop="-30dp"
            android:layout_marginHorizontal="20dp"
            android:padding="22dp"
            android:elevation="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔎 Buscar médico"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etBuscarMedico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_box"
                android:hint="Nombre o especialidad"
                android:inputType="text"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:textColor="#0A1B2E"
                android:textColorHint="#A9BCCF"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Especialidad"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍⚕️ Médico"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerMedico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📆 Fecha"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_box"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="Seleccionar fecha"
                android:textColor="#0A1B2E"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ Horario disponible"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerHora"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Motivo (opcional)"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMotivo"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:background="@drawable/input_box"
                android:gravity="top"
                android:hint="Describe brevemente el motivo"
                android:padding="14dp"
                android:textColor="#0A1B2E"
                android:textColorHint="#A9BCCF"
                android:textSize="14sp"
                android:layout_marginBottom="22dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/button_gradient"
                android:text="Confirmar cita"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Reserva con al menos 2 horas de anticipación"
            android:textColor="#A9BCCF"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="22dp" />

    </LinearLayout>
</ScrollView>