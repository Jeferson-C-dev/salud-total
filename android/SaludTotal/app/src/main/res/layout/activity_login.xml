<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera con degradado y curva -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@drawable/header_curve"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="40dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:background="@drawable/circle_ring"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/circle_blue"
                        android:gravity="center"
                        android:elevation="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="46sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salud Total"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu salud en tus manos"
                android:textColor="#48CAE4"
                android:textSize="14sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tarjeta flotante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_login"
            android:layout_marginTop="-56dp"
            android:layout_marginHorizontal="24dp"
            android:padding="24dp"
            android:elevation="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido de nuevo"
                android:textColor="#0A1B2E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa para gestionar tus citas"
                android:textColor="#6B8299"
                android:textSize="13sp"
                android:layout_marginBottom="22dp" />

            <!-- Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_box"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="correo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:paddingHorizontal="10dp"
                    android:textColor="#0A1B2E"
                    android:textColorHint="#A9BCCF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textColor="#6B8299"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_box"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingHorizontal="10dp"
                    android:textColor="#0A1B2E"
                    android:textColorHint="#A9BCCF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMostrar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mostrar"
                    android:textColor="#2E86DE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="6dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/button_gradient"
                android:text="Ingresar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- Registro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? "
                android:textColor="#6B8299"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regístrate"
                android:textColor="#2E86DE"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pie -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 Cero papel · ODS 3 · ODS 9 · ODS 12"
            android:textColor="#A9BCCF"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="24dp" />

    </LinearLayout>
</ScrollView>