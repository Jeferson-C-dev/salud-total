<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_white"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvMedico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dr(a). Nombre"
        android:textColor="#0A1B2E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEspecialidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Especialidad"
        android:textColor="#6B8299"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total 0 · Completadas 0 · Canceladas 0 · Inasistencias 0"
        android:textColor="#0A1B2E"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/barra"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E74C3C"
        android:progressBackgroundTint="#EEF3F8" />

    <TextView
        android:id="@+id/tvPorcentaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0% sin atención"
        android:textColor="#A32D2D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

</LinearLayout>